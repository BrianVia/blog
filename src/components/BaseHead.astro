---
import "../styles/global.css";
import "../styles/blog.css";
import { SEO } from "astro-seo";
import { ClientRouter } from "astro:transitions";

export interface BreadcrumbItem {
	name: string;
	item?: string;
}

export interface BlogPostingData {
	headline: string;
	description?: string;
	image?: string;
	datePublished: string;
	dateModified?: string;
	keywords?: string[];
}

export interface BaseHeadProps {
	title?: string;
	description?: string;
	imageUrl?: string;
	imageAlt?: string;
	canonicalRoute?: string;
	type?: "website" | "article";
	pubDate?: Date | string;
	modifiedDate?: Date | string;
	tags?: string[];
	author?: string;
	noindex?: boolean;
	prevUrl?: string;
	nextUrl?: string;
	includePersonSchema?: boolean;
	includeWebsiteSchema?: boolean;
	blogPosting?: BlogPostingData;
	breadcrumbs?: BreadcrumbItem[];
}

const baseTitle = "Brian | Via";
const baseDescription = "Software engineering notes, side projects, reading lists, and personal essays from Brian Via.";
const siteUrl = "https://brianvia.blog";
const siteRoot = `${siteUrl}/`;
const defaultImage = `${siteUrl}/social.png`;
const defaultImageDimensions = { width: 1012, height: 506, type: "image/png" };
const authorProfileUrl = `${siteUrl}/about/`;
const authorImageUrl = `${siteUrl}/pfp-original.jpg`;

const {
	title,
	description = baseDescription,
	imageUrl = defaultImage,
	imageAlt,
	canonicalRoute = "",
	type = "website",
	pubDate,
	modifiedDate,
	tags,
	author = authorProfileUrl,
	noindex = false,
	prevUrl,
	nextUrl,
	includePersonSchema = false,
	includeWebsiteSchema = false,
	blogPosting,
	breadcrumbs,
} = Astro.props as BaseHeadProps;

const normalizedRoute = canonicalRoute.replace(/^\/+|\/+$/g, "");
const encodedRoute = normalizedRoute
	.split("/")
	.filter(Boolean)
	.map((segment) => encodeURIComponent(segment))
	.join("/");
const canonicalURL = encodedRoute ? `${siteRoot}${encodedRoute}/` : siteRoot;
const shortenTitle = (value: string, maxLength = 45) => {
	if (value.length <= maxLength) return value;
	const excerpt = value.slice(0, maxLength + 1).replace(/\s+\S*$/, "").trim();
	return `${excerpt}…`;
};
const fullTitle = title ? `${shortenTitle(title)} - ${baseTitle}` : baseTitle;
const socialTitle = title || baseTitle;
const resolvedImageUrl = new URL(imageUrl, `${siteUrl}/`).toString();
const resolvedImageAlt = imageAlt || description;
const isDefaultImage = resolvedImageUrl === defaultImage;

// Social cards want a fast, correctly-cropped 2:1 image. Hero photos are often
// multi-MB and 16:9 — X/Twitter's crawler times out on heavy images and then
// silently drops the card. Derive a lightweight 1200x630 OG variant (the on-page
// hero is unaffected) and advertise its exact dimensions so X can render the
// large card without fetching the bytes first.
const ogImageDimensions = { width: 1200, height: 630, type: "image/jpeg" };

const toSocialImage = (url: string): { url: string; width?: number; height?: number; type?: string } => {
	// Unsplash supports on-the-fly resizing/cropping via query params.
	if (/^https?:\/\/images\.unsplash\.com\//.test(url)) {
		const u = new URL(url);
		// Drop `auto=format` — it content-negotiates WebP/AVIF and overrides `fm`,
		// which would contradict the image/jpeg type we advertise below.
		u.searchParams.delete("auto");
		u.searchParams.set("w", "1200");
		u.searchParams.set("h", "630");
		u.searchParams.set("fit", "crop");
		u.searchParams.set("crop", "entropy");
		u.searchParams.set("fm", "jpg");
		u.searchParams.set("q", "75");
		return { url: u.toString(), ...ogImageDimensions };
	}
	return { url };
};

const socialImage = isDefaultImage
	? { url: resolvedImageUrl, ...defaultImageDimensions }
	: toSocialImage(resolvedImageUrl);
const ogImageUrl = socialImage.url;

const toIso = (d: Date | string | undefined) => {
	if (!d) return undefined;
	if (d instanceof Date) return d.toISOString();
	return new Date(d).toISOString();
};

const publishedTime = toIso(pubDate);
const modifiedTime = toIso(modifiedDate);

const openGraphImage = {
	url: ogImageUrl,
	alt: resolvedImageAlt,
	...(socialImage.width
		? { width: socialImage.width, height: socialImage.height, type: socialImage.type }
		: {}),
};

const openGraphArticle =
	type === "article"
		? {
				publishedTime,
				modifiedTime,
				authors: [author],
				tags,
			}
		: undefined;

// ---------- JSON-LD schemas ----------

const personSchema = {
	"@context": "https://schema.org",
	"@type": "Person",
	name: "Brian Via",
	jobTitle: "Senior Fullstack Engineer",
	image: authorImageUrl,
	worksFor: {
		"@type": "Organization",
		name: "Dfinitiv, Inc.",
	},
	url: authorProfileUrl,
	sameAs: ["https://x.com/BrianVia", "https://github.com/BrianVia"],
	alumniOf: {
		"@type": "CollegeOrUniversity",
		name: "North Carolina State University",
	},
};

const websiteSchema = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	name: baseTitle,
	url: siteRoot,
	description: baseDescription,
	publisher: {
		"@type": "Person",
		name: "Brian Via",
		url: authorProfileUrl,
	},
	inLanguage: "en-US",
};

const blogPostingSchema = blogPosting
	? {
			"@context": "https://schema.org",
			"@type": "BlogPosting",
			headline: blogPosting.headline,
			description: blogPosting.description,
			image: blogPosting.image ? [blogPosting.image] : [defaultImage],
			datePublished: blogPosting.datePublished,
			dateModified: blogPosting.dateModified || blogPosting.datePublished,
			author: {
				"@type": "Person",
				name: "Brian Via",
				url: authorProfileUrl,
			},
			publisher: {
				"@type": "Person",
				name: "Brian Via",
				url: authorProfileUrl,
			},
			mainEntityOfPage: {
				"@type": "WebPage",
				"@id": canonicalURL,
			},
			...(blogPosting.keywords && blogPosting.keywords.length > 0
				? { keywords: blogPosting.keywords.join(", ") }
				: {}),
		}
	: null;

const breadcrumbSchema =
	breadcrumbs && breadcrumbs.length > 0
		? {
				"@context": "https://schema.org",
				"@type": "BreadcrumbList",
				itemListElement: breadcrumbs.map((crumb, index) => ({
					"@type": "ListItem",
					position: index + 1,
					name: crumb.name,
					...(crumb.item ? { item: crumb.item } : {}),
				})),
			}
		: null;
---

<SEO
  title={fullTitle}
  description={description}
  canonical={canonicalURL}
  noindex={noindex}
  nofollow={noindex}

  openGraph={{
    basic: {
      title: socialTitle,
      type,
      image: ogImageUrl,
      url: canonicalURL,
    },
    optional: {
      description,
      siteName: baseTitle,
      locale: "en_US",
    },
    image: openGraphImage,
    ...(openGraphArticle ? { article: openGraphArticle } : {}),
  }}
  twitter={{
    card: "summary_large_image",
    site: "@BrianVia",
    creator: "@BrianVia",
    title: socialTitle,
    description,
    image: ogImageUrl,
    imageAlt: resolvedImageAlt,
  }}
  extend={{
    link: [
      { rel: "icon", type: "image/x-icon", href: "/favicon.ico" },
      { rel: "preconnect", href: "https://fonts.googleapis.com" },
      { rel: "preconnect", href: "https://fonts.gstatic.com", crossorigin: "" },
      { rel: "stylesheet", href: "https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=IBM+Plex+Serif:wght@400;700&family=IBM+Plex+Mono&display=swap" },
      { rel: "alternate", type: "application/rss+xml", title: `${baseTitle} RSS Feed`, href: "/rss.xml" },
      ...(prevUrl ? [{ rel: "prev", href: prevUrl }] : []),
      ...(nextUrl ? [{ rel: "next", href: nextUrl }] : []),
    ],
    meta: [
      { name: "viewport", content: "width=device-width, initial-scale=1" },
    ],
  }}
/>

<link rel="sitemap" href="/sitemap-index.xml" />

<ClientRouter />

<script is:inline>
  // Blocking theme init — runs in <head> before any paint to avoid FOUC.
  (function () {
    try {
      var stored = localStorage.getItem("theme");
      var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      var theme = stored || (prefersDark ? "dark" : "light");
      if (theme === "dark") document.documentElement.classList.add("dark");
      if (!stored) localStorage.setItem("theme", theme);
    } catch (e) {}
  })();
</script>

{includePersonSchema && (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
)}
{includeWebsiteSchema && (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
)}
{blogPostingSchema && (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)} />
)}
{breadcrumbSchema && (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
)}
