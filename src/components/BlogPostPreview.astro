---
import { formatDate } from "../data/postMeta";

export interface Props {
  title: string;
  description: string;
  pubDate: string | Date;
  url: string;
  /** Catalog number: 1 for the oldest post. */
  number: number;
  minutes: number;
  tags?: string[];
  featured?: boolean;
  heroImageUrl?: string;
  heroImageAlt?: string;
}

const {
  title,
  description,
  pubDate,
  url,
  number,
  minutes,
  tags = [],
  featured = false,
  heroImageUrl,
  heroImageAlt,
} = Astro.props as Props;

const num = String(number).padStart(2, "0");
const date = formatDate(pubDate);
// Unsplash resizes on the fly; don't ship a 5000px photo into a 10rem thumbnail.
const thumbUrl = heroImageUrl?.startsWith("https://images.unsplash.com/")
  ? heroImageUrl.replace(/([?&])w=\d+/, "$1w=480")
  : heroImageUrl;
---

{featured ? (
  <article class="group">
    {heroImageUrl && (
      <a href={url} class="mb-8 block aspect-[16/9] overflow-hidden rounded-sm border border-line bg-paper-2">
        <img
          src={heroImageUrl}
          alt={heroImageAlt || `Featured image for ${title}`}
          class="h-full w-full object-cover"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </a>
    )}
    <p class="label mb-4 flex flex-wrap gap-x-3">
      <span class="text-ink">№ {num}</span>
      <span>{date}</span>
      <span>{minutes} min</span>
    </p>
    <h3 class="display text-[2.25rem] sm:text-5xl md:text-[3.5rem]">
      <a href={url} class="hover:text-accent transition-colors">{title}</a>
    </h3>
    <p class="mt-5 max-w-2xl text-xl text-ink-2">{description}</p>
    {tags.length > 0 && (
      <p class="label mt-6 flex flex-wrap gap-x-4">
        {tags.map((tag) => (
          <a href={`/tags/${encodeURIComponent(tag)}/`} class="hover:text-accent transition-colors">{tag}</a>
        ))}
      </p>
    )}
  </article>
) : (
  <article class="border-b border-line">
    <a href={url} class="row-link grid gap-x-6 gap-y-1 py-6 sm:grid-cols-[3.5rem_1fr_auto_10rem]">
      {heroImageUrl && (
        <span class="mb-4 block aspect-[16/9] overflow-hidden rounded-sm border border-line bg-paper-2 sm:order-last sm:mb-0 sm:mt-1">
          <img
            src={thumbUrl}
            alt={heroImageAlt || `Featured image for ${title}`}
            width="320"
            height="180"
            class="h-full w-full object-cover"
            loading="lazy"
            decoding="async"
          />
        </span>
      )}
      <span class="index-num text-lg leading-[1.35] sm:text-xl">{num}</span>
      <span>
        <span class="block font-display text-2xl leading-tight text-ink" style="font-weight:500">{title}</span>
        <span class="mt-1.5 block text-base text-ink-2">{description}</span>
        {tags.length > 0 && (
          <span class="label mt-3 flex flex-wrap gap-x-4">
            {tags.map((tag) => <span>{tag}</span>)}
          </span>
        )}
      </span>
      <span class="label mt-2 flex gap-x-3 sm:mt-1.5 sm:flex-col sm:items-end sm:gap-y-1 sm:text-right whitespace-nowrap">
        <time datetime={new Date(pubDate).toISOString()}>{date}</time>
        <span>{minutes} min</span>
      </span>
    </a>
  </article>
)}
