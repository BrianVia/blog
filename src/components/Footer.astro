---
import { primaryNav } from "../data/nav";
---

<footer class="wrapper mt-auto pt-24 pb-12">
  <div class="margin-grid border-t border-line pt-8">
    <p class="label">Colophon</p>
    <div class="flex flex-col gap-6 md:flex-row md:items-start md:justify-between">
      <p class="max-w-md text-base text-ink-2">
        Set in Fraunces and Newsreader. Built with Astro, written in Notion,
        served from Cloudflare. &copy; {new Date().getFullYear()} Brian Via.
      </p>
      <nav class="flex flex-wrap gap-x-5 gap-y-2" aria-label="Footer">
        {primaryNav.map((link) => (
          <a href={link.href} class="nav-link">{link.label}</a>
        ))}
        <a href="/rss.xml" class="nav-link">RSS</a>
      </nav>
    </div>
  </div>
</footer>
