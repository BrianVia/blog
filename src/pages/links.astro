---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import BookmarkGrid from "../components/BookmarkGrid.astro";
import { BOOKMARKS_PER_PAGE, getBookmarks } from "../lib/bookmarks";

const allBookmarks = await getBookmarks();
const sortedLinks = allBookmarks.slice(0, BOOKMARKS_PER_PAGE);
const totalPages = Math.ceil(allBookmarks.length / BOOKMARKS_PER_PAGE);

const title = "Bookmarked Links";
const description = "A curated archive of useful articles, tools, products, and ideas saved from Readwise Reader and Raindrop.";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <BaseHead title={title} description={description} canonicalRoute="links" />
  </head>

  <body>
    <Header />

    <main id="main-content" class="wrapper py-16 md:py-24">
      <!-- Hero Section -->
      <section class="text-center mb-24 md:mb-32">
        <h1 class="text-6xl md:text-8xl font-bold font-heading text-ink mb-8 tracking-tight leading-[0.9]">
          {title}
        </h1>
        <div class="max-w-2xl mx-auto">
          <p class="text-2xl md:text-3xl font-serif italic text-ink-light">
            {description}
          </p>
        </div>
      </section>

      <!-- Links Grid -->
      <section aria-label="Bookmarked links">
        <div class="flex items-center gap-4 mb-12">
          <span class="h-px bg-ink/10 flex-1"></span>
          <h2 class="text-sm font-sans font-bold uppercase tracking-widest text-ink-lighter">Reading List</h2>
          <span class="h-px bg-ink/10 flex-1"></span>
        </div>

        <BookmarkGrid bookmarks={sortedLinks} />

        {totalPages > 1 && (
          <nav aria-label="Bookmark archive pages" class="mt-16 flex justify-center">
            <a href="/links/2/" rel="next" class="nav-link">Older bookmarks →</a>
          </nav>
        )}
      </section>
    </main>

    <Footer />
  </body>
</html>
