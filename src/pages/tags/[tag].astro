---
import { getCollection } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import BlogPostPreview from "../../components/BlogPostPreview.astro";
import { readingMinutes } from "../../data/postMeta";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  const published = posts
    .filter((p) => p.data.published === true)
    .sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf());

  // Catalog number: oldest post is 01, matching the home page index.
  const numbers = new Map(published.map((p, i) => [p.id, published.length - i]));

  const byTag = new Map<string, typeof published>();
  for (const post of published) {
    for (const tag of post.data.tags || []) {
      const list = byTag.get(tag) ?? [];
      list.push(post);
      byTag.set(tag, list);
    }
  }

  return [...byTag.entries()].map(([tag, tagPosts]) => ({
    params: { tag },
    props: {
      tag,
      posts: tagPosts.map((post) => ({ post, number: numbers.get(post.id) ?? 0 })),
    },
  }));
}

const { tag, posts } = Astro.props;
const title = `#${tag}`;
const description = `Browse Brian Via's journal entries tagged “${tag},” including notes, lessons, and practical ideas from recent projects.`;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <BaseHead title={title} description={description} canonicalRoute={`tags/${tag}`} />
  </head>
  <body>
    <Header />

    <main id="main-content" class="wrapper">
      <section class="margin-grid pt-14 pb-12 md:pt-20 md:pb-16">
        <p class="label md:pt-3">Tag</p>
        <div>
          <h1 class="display text-[2.5rem] sm:text-5xl md:text-6xl">{tag}</h1>
          <p class="mt-6 font-display text-xl italic leading-snug text-ink-2 md:text-2xl" style="font-weight:300">
            {posts.length} {posts.length === 1 ? "post" : "posts"}
          </p>
        </div>
      </section>

      <section class="margin-grid border-t border-line pt-8" aria-label={`Posts tagged ${tag}`}>
        <p class="label"><a href="/tags/" class="hover:text-accent transition-colors">&larr; All tags</a></p>
        <div>
          {posts.map(({ post, number }) => (
            <BlogPostPreview
              title={post.data.title}
              description={post.data.description || ""}
              pubDate={post.data.pubDate}
              url={`/posts/${post.data.slug}/`}
              number={number}
              minutes={readingMinutes(post.body)}
              tags={post.data.tags || []}
            />
          ))}
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>
