---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const title = "Page Not Found";
const description = "The page you're looking for doesn't exist or has moved.";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <BaseHead
      title={title}
      description={description}
      canonicalRoute="404"
      noindex={true}
    />
  </head>

  <body>
    <Header />

    <main id="main-content" class="wrapper">
      <section class="margin-grid pt-14 pb-20 md:pt-20 md:pb-28">
        <p class="label md:pt-3">Error 404</p>
        <div>
          <h1 class="display text-[2.5rem] sm:text-5xl md:text-6xl">Lost in the stacks</h1>
          <p class="mt-6 max-w-xl font-display text-xl italic leading-snug text-ink-2 md:text-2xl" style="font-weight:300">
            The page you're looking for doesn't exist, or maybe it never did.
          </p>
          <p class="mt-10">
            <a href="/" class="nav-link">&larr; Back to the Journal</a>
          </p>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>
