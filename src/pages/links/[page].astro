---
import BaseHead from "../../components/BaseHead.astro";
import BookmarkGrid from "../../components/BookmarkGrid.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import { BOOKMARKS_PER_PAGE, getBookmarks } from "../../lib/bookmarks";

export async function getStaticPaths() {
  const bookmarks = await getBookmarks();
  const totalPages = Math.ceil(bookmarks.length / BOOKMARKS_PER_PAGE);
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => {
    const page = index + 2;
    const start = (page - 1) * BOOKMARKS_PER_PAGE;
    return {
      params: { page: String(page) },
      props: {
        bookmarks: bookmarks.slice(start, start + BOOKMARKS_PER_PAGE),
        page,
        totalPages,
      },
    };
  });
}

const { bookmarks, page, totalPages } = Astro.props;
const title = `Bookmarked Links – Page ${page}`;
const description = `Browse page ${page} of Brian Via's curated archive of useful articles, tools, products, and ideas from across the web.`;
const previousUrl = page === 2 ? "/links/" : `/links/${page - 1}/`;
const nextUrl = page < totalPages ? `/links/${page + 1}/` : undefined;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <BaseHead
      title={title}
      description={description}
      canonicalRoute={`links/${page}`}
      prevUrl={previousUrl}
      nextUrl={nextUrl}
    />
  </head>
  <body>
    <Header />
    <main id="main-content" class="wrapper py-16 md:py-24">
      <header class="text-center mb-16">
        <h1 class="text-5xl md:text-7xl font-bold font-heading text-ink mb-6 tracking-tight">
          Bookmarked Links
        </h1>
        <p class="text-xl font-serif italic text-ink-light">Archive page {page} of {totalPages}</p>
      </header>

      <BookmarkGrid bookmarks={bookmarks} />

      <nav aria-label="Bookmark archive pages" class="mt-16 flex justify-between">
        <a href={previousUrl} rel="prev" class="nav-link">← Newer bookmarks</a>
        {nextUrl && <a href={nextUrl} rel="next" class="nav-link">Older bookmarks →</a>}
      </nav>
    </main>
    <Footer />
  </body>
</html>
