---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";


const title = "Books I've Read";
const description = "Browse books Brian Via has recently read, along with ratings and concise notes on the ideas that made each title memorable.";

const books = [
  {
    title: "The Anthology of Balaji",
    author: "Balaji Srinivasan",
    dateRead: "2025-11",
    rating: "",
    notes: ""
  },
  {
    title: "Boom: Bubbles and the End of Stagnation",
    author: "Byrne Hobart",
    dateRead: "2025-04",
    rating: "",
    notes: ""
  },
  {
    title: "Poor Charlie's Almanack - The Essential Wit and Wisdom of Charles T. Munger",
    author: "Peter Kaufman",
    dateRead: "2024 (All of it)",
    rating: "5/5",
    notes: "A comprehensive collection of Charlie Munger's wisdom and mental models"
  },
  {
    title: "Think and Grow Rich",
    author: "Napoleon Hill",
    dateRead: "2024-12",
    rating: "4/5",
    notes: "Classic self-improvement book about achieving success through mindset and persistence"
  }
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <BaseHead title={title} description={description} canonicalRoute="books" />
  </head>

  <body>
    <Header />

    <main id="main-content" class="wrapper">
      <section class="margin-grid pt-14 pb-12 md:pt-20 md:pb-16">
        <p class="label md:pt-3">Library</p>
        <div>
          <h1 class="display text-[2.5rem] sm:text-5xl md:text-6xl">{title}</h1>
          <p class="mt-6 max-w-xl font-display text-xl italic leading-snug text-ink-2 md:text-2xl" style="font-weight:300">
            A running list of books that have shaped my thinking, most recent first.
          </p>
        </div>
      </section>

      <section class="margin-grid border-t border-line pt-8">
        <p class="label">{books.length} titles</p>
        <ol>
          {books.map((book) => (
            <li class="grid gap-x-6 gap-y-1 border-b border-line py-6 sm:grid-cols-[1fr_auto]">
              <div>
                <p class="font-display text-2xl leading-tight text-ink" style="font-weight:500">{book.title}</p>
                <p class="mt-1 text-base text-ink-2">{book.author}</p>
                {book.notes && <p class="mt-3 max-w-xl text-base text-ink-2">{book.notes}</p>}
              </div>
              <p class="label mt-2 flex gap-x-3 sm:mt-1.5 sm:flex-col sm:items-end sm:gap-y-1 sm:text-right whitespace-nowrap">
                <span>{book.dateRead}</span>
                {book.rating && <span class="text-ink">{book.rating}</span>}
              </p>
            </li>
          ))}
        </ol>
      </section>
    </main>

    <Footer />
  </body>
</html>
