---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";


let title = "Social";
let intro = `Here's how to get in touch with me if you'd like to!`;
const description = "Contact Brian Via by email or connect through X, LinkedIn, and GitHub to talk about software engineering, projects, and ideas.";

const links = [
  { label: "X", handle: "@BrianVia", href: "https://x.com/BrianVia" },
  { label: "GitHub", handle: "BrianVia", href: "https://github.com/BrianVia" },
  { label: "LinkedIn", handle: "brian-via", href: "https://linkedin.com/in/🧑‍💻brian-via-5b242a65" },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <BaseHead title={title} description={description} imageUrl="/social.png" canonicalRoute="social" />
  </head>

  <body>
    <Header />

    <main id="main-content" class="wrapper">
      <section class="margin-grid pt-14 pb-12 md:pt-20 md:pb-16">
        <p class="label md:pt-3">Social</p>
        <div>
          <h1 class="display text-[2.5rem] sm:text-5xl md:text-6xl">Say hello</h1>
          <p class="mt-6 max-w-xl font-display text-xl italic leading-snug text-ink-2 md:text-2xl" style="font-weight:300">
            {intro}
          </p>
        </div>
      </section>

      <section class="margin-grid border-t border-line pt-8">
        <p class="label">Elsewhere</p>
        <ul>
          <li class="border-b border-line">
            <!--email_off-->
            <a href="mailto:inquiries@brianvia.com" class="row-link group flex items-baseline justify-between gap-6 py-5">
              <span class="font-display text-2xl leading-tight text-ink group-hover:text-accent transition-colors" style="font-weight:500">Email</span>
              <span class="label truncate">inquiries@brianvia.com &rarr;</span>
            </a>
            <!--/email_off-->
          </li>
          {links.map((item) => (
            <li class="border-b border-line">
              <a href={item.href} class="row-link group flex items-baseline justify-between gap-6 py-5">
                <span class="font-display text-2xl leading-tight text-ink group-hover:text-accent transition-colors" style="font-weight:500">{item.label}</span>
                <span class="label truncate">{item.handle} &rarr;</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    </main>

    <Footer />
  </body>
</html>
