---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";


const title = "RSS Feeds";
const description = "Subscribe to custom, regularly updated RSS feeds for thoughtful writers and creators, beginning with Paul Graham's essays.";

interface Feed {
  title: string;
  description: string;
  url: string;
  author: string;
  imageUrl?: string;
}

const feeds: Feed[] = [
  {
    title: "Paul Graham Essays",
    description: "A home-built feed of Paul Graham's essays from paulgraham.com, updated regularly.",
    url: "/feeds/paul-graham.xml",
    author: "Paul Graham",
    imageUrl: "https://sep.yimg.com/ca/I/paulgraham_2202_8901"
  }
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <BaseHead title={title} description={description} canonicalRoute="feeds" />
  </head>

  <body>
    <Header />

    <main id="main-content" class="wrapper">
      <section class="margin-grid pt-14 pb-12 md:pt-20 md:pb-16">
        <p class="label md:pt-3">Feeds</p>
        <div>
          <h1 class="display text-[2.5rem] sm:text-5xl md:text-6xl">{title}</h1>
          <p class="mt-6 max-w-xl font-display text-xl italic leading-snug text-ink-2 md:text-2xl" style="font-weight:300">
            Hand-built RSS feeds for writers who don't publish one.
          </p>
        </div>
      </section>

      <section class="margin-grid border-t border-line pt-8">
        <p class="label">{feeds.length} {feeds.length === 1 ? "feed" : "feeds"}</p>
        <ul>
          {feeds.map((feed) => (
            <li class="flex flex-col gap-6 border-b border-line py-6 sm:flex-row sm:items-start">
              {feed.imageUrl && (
                <img
                  src={feed.imageUrl}
                  alt={feed.title}
                  class="h-20 w-20 flex-none rounded-sm border border-line object-cover"
                  width="80"
                  height="80"
                  loading="lazy"
                />
              )}
              <div class="flex-1">
                <h2 class="font-display text-2xl leading-tight text-ink" style="font-weight:500">{feed.title}</h2>
                <p class="label mt-1">by {feed.author}</p>
                <p class="mt-3 max-w-xl text-base text-ink-2">{feed.description}</p>
                <p class="mt-5 flex flex-wrap gap-x-6 gap-y-2">
                  <a href={feed.url} class="nav-link text-ink">Subscribe via RSS &rarr;</a>
                  <button
                    type="button"
                    onclick={`navigator.clipboard.writeText('${new URL(feed.url, "https://brianvia.blog")}')`}
                    class="nav-link"
                  >
                    Copy feed URL
                  </button>
                </p>
              </div>
            </li>
          ))}
        </ul>
      </section>
    </main>

    <Footer />
  </body>
</html>
