---
import { getCollection } from 'astro:content';
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BlogPostPreview from "../components/BlogPostPreview.astro";
import { readingMinutes } from "../data/postMeta";

let title = "Side Effects";

// Use content collections to fetch all posts
const allPosts = await getCollection('posts');
const sortedPosts = allPosts
  .filter((post) => post.data.published === true)
  .sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf());

// slice first index and return modified original array
const finalSortedPosts = sortedPosts.length > 1 ? sortedPosts.slice(1) : [];
const mostRecentPost = sortedPosts.length > 0 ? sortedPosts[0] : null;
const total = sortedPosts.length;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <BaseHead
      title={title}
      includePersonSchema={true}
      includeWebsiteSchema={true}
    />
  </head>

  <body>
    <Header />

    <main id="main-content" class="wrapper">
      <section class="grid gap-y-6 pt-14 pb-20 md:grid-cols-[auto_1fr] md:items-end md:gap-x-16 md:pt-24 md:pb-28">
        <h1 class="display text-[3.25rem] sm:text-7xl md:text-[5.5rem]">
          Side<br class="hidden md:block" /> Effects
        </h1>
        <p class="max-w-lg font-display text-2xl italic leading-snug text-ink-2 md:text-[1.75rem] md:pb-3" style="font-weight:300">
          Notes from a fullstack engineer on building software, and on the
          parenting, cooking, and training that happen around it.
        </p>
      </section>

      {mostRecentPost && (
        <section id="most-recent-post" class="margin-grid border-t border-line pt-8 pb-20 md:pb-28">
          <h2 class="label">Latest</h2>
          <BlogPostPreview
            title={mostRecentPost.data.title}
            description={mostRecentPost.data.description || ""}
            pubDate={mostRecentPost.data.pubDate}
            url={`/posts/${mostRecentPost.data.slug}/`}
            number={total}
            minutes={readingMinutes(mostRecentPost.body)}
            featured={true}
            tags={mostRecentPost.data.tags || []}
            heroImageUrl={mostRecentPost.data.heroImageUrl}
            heroImageAlt={mostRecentPost.data.heroImageAlt}
          />
        </section>
      )}

      <section class="margin-grid border-t border-line pt-8" aria-label="Blog post list">
        <h2 class="label">Archive <span class="text-ink-3">· {finalSortedPosts.length}</span></h2>
        <div>
          {finalSortedPosts.map((post, i) => (
            <BlogPostPreview
              title={post.data.title}
              description={post.data.description || ""}
              pubDate={post.data.pubDate}
              url={`/posts/${post.data.slug}/`}
              number={total - 1 - i}
              minutes={readingMinutes(post.body)}
              tags={post.data.tags || []}
              heroImageUrl={post.data.heroImageUrl}
              heroImageAlt={post.data.heroImageAlt}
            />
          ))}
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>
