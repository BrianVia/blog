---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { formatDate } from "../data/postMeta";

export interface AdjacentPost {
  slug: string;
  title: string;
}

export interface Props {
  content: {
    title: string;
    description?: string;
    pubDate: string;
    modifiedDate?: string;
    slug: string;
    tags?: string[];
    heroImageUrl?: string;
    heroImageAlt?: string;
  };
  number: number;
  minutes: number;
  prevPost?: AdjacentPost;
  nextPost?: AdjacentPost;
}

const {
  content: { title, description, pubDate, modifiedDate, slug, tags = [], heroImageUrl, heroImageAlt },
  number,
  minutes,
  prevPost,
  nextPost,
} = Astro.props as Props;

const suppliedDescription = description?.trim();
const metaDescriptionCandidate = suppliedDescription && suppliedDescription.length >= 70
  ? suppliedDescription
  : suppliedDescription
    ? `${suppliedDescription.replace(/[.!?]?$/, ".")} Read Brian Via's notes and perspective on ${title}.`
    : `Read ${title}, a journal entry by Brian Via about software engineering, technology, and the lessons learned while building.`;
const metaDescription = metaDescriptionCandidate.length > 155
  ? `${metaDescriptionCandidate.slice(0, 152).replace(/\s+\S*$/, "")}…`
  : metaDescriptionCandidate;

const prevUrl = prevPost ? `https://brianvia.blog/posts/${prevPost.slug}/` : undefined;
const nextUrl = nextPost ? `https://brianvia.blog/posts/${nextPost.slug}/` : undefined;

// Use heroImageUrl directly
const heroImageSrc = heroImageUrl;
const heroImageAltText = heroImageAlt || title;
// Notion-hosted images are mirrored into /images/notion at fetch time, so the
// hero is usually a site-relative path. Structured data needs an absolute URL.
const heroImageAbsolute = heroImageSrc
  ? new URL(heroImageSrc, "https://brianvia.blog/").toString()
  : undefined;

const formattedDate = formatDate(pubDate);
const num = String(number).padStart(2, "0");

const blogPosting = {
  headline: title,
  description: metaDescription,
  image: heroImageAbsolute,
  datePublished: new Date(pubDate).toISOString(),
  dateModified: modifiedDate ? new Date(modifiedDate).toISOString() : undefined,
  keywords: tags,
};

const breadcrumbs = [
  { name: "Journal", item: "https://brianvia.blog/" },
  { name: title },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <BaseHead
      title={title}
      description={metaDescription}
      imageUrl={heroImageSrc}
      imageAlt={heroImageAltText}
      canonicalRoute={`posts/${slug}`}
      type="article"
      pubDate={pubDate}
      modifiedDate={modifiedDate}
      tags={tags}
      blogPosting={blogPosting}
      breadcrumbs={breadcrumbs}
      prevUrl={prevUrl}
      nextUrl={nextUrl}
    />
  </head>

  <body>
    <Header />

    <article class="wrapper">
      <header class="margin-grid pt-14 pb-10 md:pt-20 md:pb-14">
        <p class="label md:pt-3">
          <span class="text-ink">№ {num}</span>
        </p>
        <div class="max-w-3xl">
          <h1 class="display text-[2.5rem] sm:text-5xl md:text-6xl">{title}</h1>
          {description && (
            <p class="mt-6 max-w-2xl font-display text-xl italic leading-snug text-ink-2 md:text-2xl" style="font-weight:300">
              {description}
            </p>
          )}
          <p class="label mt-8 flex flex-wrap gap-x-4 gap-y-1">
            <time datetime={new Date(pubDate).toISOString()}>{formattedDate}</time>
            <span>{minutes} min read</span>
            {tags.map((tag) => (
              <a href={`/tags/${encodeURIComponent(tag)}/`} class="hover:text-accent transition-colors">{tag}</a>
            ))}
          </p>
        </div>
      </header>

      {heroImageSrc && (
        <div class="aspect-[16/9] overflow-hidden rounded-sm border border-line bg-paper-2">
          <img
            src={heroImageSrc}
            alt={heroImageAltText}
            class="h-full w-full object-cover"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      )}

      <div class="margin-grid pt-12 md:pt-16">
        <div class="hidden md:block" aria-hidden="true"></div>
        <main id="main-content" class="post-content">
          <!--email_off-->
          <slot />
          <!--/email_off-->
        </main>
      </div>

      <footer class="margin-grid mt-20 border-t border-line pt-8">
        <p class="label">Continue</p>
        <div>
          {(prevPost || nextPost) && (
            <nav aria-label="Post navigation" class="grid gap-8 sm:grid-cols-2">
              {prevPost ? (
                <a href={`/posts/${prevPost.slug}/`} rel="prev" class="group block">
                  <span class="label block mb-2">Older</span>
                  <span class="font-display text-xl leading-tight text-ink group-hover:text-accent transition-colors" style="font-weight:500">{prevPost.title}</span>
                </a>
              ) : <div />}
              {nextPost ? (
                <a href={`/posts/${nextPost.slug}/`} rel="next" class="group block sm:text-right">
                  <span class="label block mb-2">Newer</span>
                  <span class="font-display text-xl leading-tight text-ink group-hover:text-accent transition-colors" style="font-weight:500">{nextPost.title}</span>
                </a>
              ) : <div />}
            </nav>
          )}
          <p class="mt-10">
            <a href="/" class="nav-link">&larr; Back to the Journal</a>
          </p>
        </div>
      </footer>
    </article>

    <Footer />
  </body>
</html>
