---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";

export interface StaticContentPageProps {
  content: {
    title: string;
    description: string;
    canonicalRoute: string;
    includePersonSchema?: boolean;
  };
}

const {
  content: { title, description, canonicalRoute, includePersonSchema = false },
} = Astro.props as StaticContentPageProps;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <BaseHead
      title={title}
      description={description}
      canonicalRoute={canonicalRoute}
      includePersonSchema={includePersonSchema}
    />
  </head>

  <body>
    <Header />

    <div class="wrapper margin-grid pt-14 md:pt-20">
      <div class="hidden md:block" aria-hidden="true"></div>
      <main id="main-content" class="post-content">
        <slot />
      </main>
    </div>

    <Footer />
  </body>
</html>
